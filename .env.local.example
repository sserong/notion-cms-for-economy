# ==========================================
# 오늘의 경제뉴스 겟 블로그 환경 변수
# ==========================================
# 이 파일을 복사하여 .env.local로 이름을 바꾸고 실제 값을 입력하세요
# cp .env.local.example .env.local

# ------------------------------------------
# Notion API 설정 (필수)
# ------------------------------------------
# Notion 통합(Integration)에서 발급받은 API 키
# 참고: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 데이터베이스 ID
# 데이터베이스 URL에서 추출: notion.so/[workspace]/[DATABASE_ID]?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------
# 앱 URL 설정 (선택)
# ------------------------------------------
# 로컬 개발 환경
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel 배포 시 자동으로 설정됨
# VERCEL_URL=

# 온디맨드 캐시 무효화 — 최신정보 확인하기 버튼 인증 토큰
REVALIDATE_SECRET=your-secret-token-here
